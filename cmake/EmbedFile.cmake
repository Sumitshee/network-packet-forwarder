# [phase 17] Writes a binary file into a C++ header as a std::array of bytes, so that npf carries
# its XDP program instead of looking for it on disk at run time.
#
#   cmake -DIN=<file> -DOUT=<header> -DNAME=<identifier> -P EmbedFile.cmake

file(READ "${IN}" hex HEX)
string(LENGTH "${hex}" digits)
math(EXPR size "${digits} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE "${OUT}"
  "// Generated by cmake/EmbedFile.cmake from ${IN}: do not edit.\n"
  "#pragma once\n\n"
  "#include <array>\n\n"
  "inline constexpr std::array<unsigned char, ${size}> ${NAME}{${bytes}};\n")
